# Postgres connection string. Same as Optimist Vendors: Neon / Vercel
# Postgres / Supabase / any Postgres. Use the *pooled* connection string in
# production (e.g. Neon's "-pooler" host).
DATABASE_URL=postgres://user:password@host/dbname

# Random long secret used to sign session cookies (admin login, captain and
# team-member access). Generate with:  openssl rand -base64 48
SESSION_SECRET=

# Stripe. Leave both unset to run checkout in TEST MODE (simulated card form,
# no money moves) — handy until the Stripe account is ready.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: public URL used for Stripe redirect links. Defaults to the
# request's own host, which is right on Vercel.
# PUBLIC_URL=https://inscripciones.reisin.mx

# Used only by `npm run db:seed` to create the first admin login.
# SEED_ADMIN_EMAIL=rr@optimistinc.mx
# SEED_ADMIN_PASSWORD=change-me
# SEED_ADMIN_NAME=Rafa
